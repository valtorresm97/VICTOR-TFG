PROJECT_ROOT = Path(__file__).resolve().parent.parent
PYTHON_DIR = PROJECT_ROOT / "python"
STATE_DIR = PROJECT_ROOT / "state"
BACKEND_PID_PATH = STATE_DIR / "backend.pid"
BACKEND_STDOUT_PATH = STATE_DIR / "backend_stdout.log"
BACKEND_STDERR_PATH = STATE_DIR / "backend_stderr.log"

# -----------------------------------------------------------------------------
# Periodos de refresco por zonas.
# - Features principales: rápido
# - Banner superior: intermedio
# - Estado del sistema: más lento
# -----------------------------------------------------------------------------
FAST_FEATURES_PERIOD_SEC = 0.30
STATUS_PERIOD_SEC = 0.75
SLOW_SYSTEM_PERIOD_SEC = 1.00


# -----------------------------------------------------------------------------
# Helpers de formato para que la UI degrade de forma segura cuando falten datos.
# -----------------------------------------------------------------------------
def _fmt(v, nd=3, default="n/a"):
    """Formatea un número decimal de forma robusta."""
    if v is None:
        return default
    try:
        return f"{float(v):.{nd}f}"
    except Exception:
        return default


def _fmt_hz(v, default="n/a"):
    """Formatea una frecuencia en Hz."""
    if v is None:
        return default
    try:
        return f"{float(v):.2f} Hz"
    except Exception:
        return default


def _fmt_sci(v, default="n/a"):
    """Formatea un número en notación científica."""
    if v is None:
        return default
    try:
        return f"{float(v):.3e}"
    except Exception:
        return default


def _fmt_us(v, default="n/a"):
    """Formatea un tiempo en microsegundos."""
    if v is None:
        return default
    try:
        return f"{float(v):.1f} us"
    except Exception:
        return default


# -----------------------------------------------------------------------------
# Helpers de control de proceso del backend.
# El dashboard usa un fichero PID sencillo como contrato mínimo de proceso vivo.
# -----------------------------------------------------------------------------
def _read_pid() -> int | None:
    """Lee el PID del backend desde disco."""
    try:
        txt = BACKEND_PID_PATH.read_text(encoding="utf-8").strip()
        if not txt:
            return None
        return int(txt)
    except Exception:
        return None


def _pid_is_alive(pid: int | None) -> bool:
    """Comprueba si el PID sigue vivo en el sistema."""
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _start_backend_if_needed() -> tuple[bool, str]:
    """
    Arranca el backend si no está vivo.

    Antes de arrancar, limpia el estado runtime anterior para evitar que la
    nueva sesión herede snapshots o history de una ejecución previa.
    """
    ensure_state_dir()

    pid = _read_pid()
    if _pid_is_alive(pid):
        return True, f"Backend activo (pid={pid})"

    clear_runtime_state()

    backend_path = PYTHON_DIR / "backend_service.py"
    if not backend_path.exists():
        return False, f"No existe backend_service.py en {backend_path}"

    stdout_f = open(BACKEND_STDOUT_PATH, "ab")
    stderr_f = open(BACKEND_STDERR_PATH, "ab")

    proc = subprocess.Popen(
        [sys.executable, str(backend_path)],
        cwd=str(PYTHON_DIR),
        stdout=stdout_f,
        stderr=stderr_f,
        start_new_session=True,
    )

    BACKEND_PID_PATH.write_text(str(proc.pid), encoding="utf-8")
    return True, f"Backend lanzado (pid={proc.pid})"


def _stop_backend() -> tuple[bool, str]:
    """
    Detiene el backend y limpia el estado runtime.

    La limpieza aquí es intencionada: cuando el backend ya no vive, no queremos
    dejar al dashboard mostrando snapshots antiguos como si siguieran vivos.
    """
    pid = _read_pid()

    if not _pid_is_alive(pid):
        try:
            BACKEND_PID_PATH.unlink(missing_ok=True)
        except Exception:
            pass
        clear_runtime_state()
        return True, "Backend ya parado"

    try:
        os.kill(pid, signal.SIGTERM)
        time.sleep(0.5)

        if _pid_is_alive(pid):
            os.kill(pid, signal.SIGKILL)

        BACKEND_PID_PATH.unlink(missing_ok=True)
        clear_runtime_state()
        return True, f"Backend detenido (pid={pid})"
    except Exception as e:
        return False, f"No se pudo detener backend: {e}"


# -----------------------------------------------------------------------------
# Helpers para derivar lecturas útiles del último feature bueno.
# Estos cálculos no son DSP; son solo preparación de UI.
# -----------------------------------------------------------------------------
def _dominant_band(last_good: dict) -> tuple[str, float | None]:
    """Devuelve la banda dominante y su peso relativo."""
    bp = last_good.get("bandpower_rel", {}) or {}
    if not bp:
        return "n/a", None
    try:
        band = max(bp, key=bp.get)
        return band, bp.get(band)
    except Exception:
        return "n/a", None


def _band_rel_dict(last_good: dict):
    """Extrae el diccionario de potencia relativa por banda."""
    return last_good.get("bandpower_rel", {}) or {}


def _band_abs_dict(last_good: dict):
    """Extrae el diccionario de potencia absoluta por banda."""
    return last_good.get("bandpower_abs", {}) or {}


# -----------------------------------------------------------------------------
# Helpers de edad / frescura.
# Se mantienen aunque ya no estén en el panel principal.
# -----------------------------------------------------------------------------
def _published_snapshot_age_s(snapshot: dict) -> float | None:
    """Edad desde la publicación física del snapshot JSON."""
    t_pub = snapshot.get("published_at_unix")
    if t_pub is None:
        return None
    try:
        return max(0.0, time.time() - float(t_pub))
    except Exception:
        return None


def _estimated_event_age_s(snapshot: dict, event_monotonic) -> float | None:
    """
    Estima la edad actual de un evento ocurrido en tiempo monotónico del backend.

    Se compone de:
      1) edad del evento en el momento en que se construyó el snapshot
      2) retraso desde que se publicó el snapshot hasta ahora
    """
    if event_monotonic is None:
        return None

    try:
        t_pub = snapshot.get("published_at_unix")
        t_snap_mono = snapshot.get("ts_monotonic")
        if t_pub is None or t_snap_mono is None:
            return None

        publish_delay = max(0.0, time.time() - float(t_pub))
        age_at_snapshot = max(0.0, float(t_snap_mono) - float(event_monotonic))
        return age_at_snapshot + publish_delay
    except Exception:
        return None


# -----------------------------------------------------------------------------
# Helpers de caché visual del snapshot.
# Esta caché NO sustituye a la verdad del backend; solo evita que la UI pierda
# continuidad si una lectura puntual falla o llega vacía.
# -----------------------------------------------------------------------------
def _init_ui_state(st):
    """Inicializa el estado visual mínimo de la app."""
    if "system_view" not in st.session_state:
        st.session_state.system_view = "Estado"

    if "ui_last_valid_snapshot" not in st.session_state:
        st.session_state.ui_last_valid_snapshot = None

    if "ui_last_snapshot_source" not in st.session_state:
        st.session_state.ui_last_snapshot_source = "none"


def _clear_ui_snapshot_cache(st):
    """Borra la caché visual cuando el backend no está activo."""
    st.session_state.ui_last_valid_snapshot = None
    st.session_state.ui_last_snapshot_source = "none"


def _load_snapshot_for_render(st) -> tuple[bool, dict, str]:
    """
    Carga el snapshot que se va a renderizar.

    Devuelve:
      - backend_alive: si el proceso backend vive
      - snapshot: snapshot a renderizar (live o cached)
      - source: "live", "cached" o "none"

    Regla:
      - si backend muerto -> no se usa caché, se limpia
      - si backend vivo y hay snapshot válido -> usar live y actualizar caché
      - si backend vivo pero la lectura falla -> usar último válido cacheado
    """
    pid = _read_pid()
    backend_alive = _pid_is_alive(pid)

    if not backend_alive:
        _clear_ui_snapshot_cache(st)
        return False, {}, "none"

    live_snapshot = read_snapshot(default=None)

    if isinstance(live_snapshot, dict) and live_snapshot:
        st.session_state.ui_last_valid_snapshot = live_snapshot
        st.session_state.ui_last_snapshot_source = "live"
        return True, live_snapshot, "live"

    cached_snapshot = st.session_state.get("ui_last_valid_snapshot")
    if isinstance(cached_snapshot, dict) and cached_snapshot:
        st.session_state.ui_last_snapshot_source = "cached"
        return True, cached_snapshot, "cached"

    st.session_state.ui_last_snapshot_source = "none"
    return True, {}, "none"


# -----------------------------------------------------------------------------
# Bloques de render.
# -----------------------------------------------------------------------------
def _render_startup_status(st, snapshot: dict | None, backend_alive: bool):
    """Renderiza el bloque de estado general del sistema al arrancar."""
    if not backend_alive:
        st.info("Pulsa Start backend para iniciar adquisición y procesamiento EEG.")
        return

    if not snapshot:
        st.info("Iniciando backend...")
        st.progress(15)
        return

    status = snapshot.get("status", {}) or {}
    buffer = snapshot.get("buffer", {}) or {}

    state_text = status.get("state_text", "n/a")
    ready = bool(status.get("window_ready", False))
    min_sec = buffer.get("min_seconds")
    need_sec = buffer.get("needed_seconds")

    if state_text == "feature_failed":
        st.error("El backend está activo, pero el último intento de cálculo ha fallado.")
        return

    if not ready:
        st.warning("Filling window… esperando a completar la ventana de análisis.")
        if min_sec is not None and need_sec:
            try:
                ratio = max(0.0, min(1.0, float(min_sec) / float(need_sec)))
                st.progress(ratio)
                st.caption(f"Ventana disponible: {float(min_sec):.2f}s / {float(need_sec):.2f}s")
            except Exception:
                pass
        return

    st.success("Sistema running. Ventana lista y snapshot disponible.")


def _render_relative_band_volume_bars_fallback(st, rel_bp: dict, abs_bp: dict, dominant_band: str):
    """
    Fallback nativo con st.progress si streamlit-echarts no está disponible.
    """
    st.markdown("**Potencia relativa por banda · live**")

    order = ["delta", "theta", "alpha", "beta", "gamma"]

    for band in order:
        rel_value = rel_bp.get(band)
        abs_value = abs_bp.get(band)

        try:
            rel_value_float = float(rel_value)
        except Exception:
            rel_value_float = 0.0

        rel_value_float = max(0.0, min(1.0, rel_value_float))

        label = band.capitalize()
        if band == dominant_band:
            label += " ★"

        c1, c2, c3 = st.columns([1.2, 4.8, 1.4])

        with c1:
            st.markdown(f"**{label}**")

        with c2:
            st.progress(rel_value_float)

        with c3:
            st.markdown(f"**{_fmt(rel_value, nd=3)}**")

        st.caption(f"Potencia absoluta: {_fmt_sci(abs_value)}")


def _build_echarts_volume_options(rel_bp: dict, abs_bp: dict, dominant_band: str) -> dict:
    """
    Construye las opciones ECharts para barras tipo DAW/VU meter.
    """
    order = ["delta", "theta", "alpha", "beta", "gamma"]

    categories = []
    values = []
    colors = []

    for band in order:
        rel_value = rel_bp.get(band)
        abs_value = abs_bp.get(band)

        try:
            rel_value_float = float(rel_value)
        except Exception:
            rel_value_float = 0.0

        rel_value_float = max(0.0, min(1.0, rel_value_float))
        values.append(round(rel_value_float, 3))

        label = band.capitalize()
        if band == dominant_band:
            label += " ★"

        categories.append(f"{label}\nabs: {_fmt_sci(abs_value)}")

        if band == dominant_band:
            colors.append("#f59e0b")
        else:
            colors.append("#38bdf8")

    return {
        "animation": True,
        "animationDuration": 120,
        "animationDurationUpdate": 120,
        "animationEasing": "linear",
        "animationEasingUpdate": "linear",
        "grid": {
            "left": 110,
            "right": 55,
            "top": 10,
            "bottom": 10,
            "containLabel": False,
        },
        "xAxis": {
            "type": "value",
            "min": 0.0,
            "max": 1.0,
            "splitNumber": 5,
            "axisLine": {"show": False},
            "axisTick": {"show": False},
            "splitLine": {"show": True},
        },
        "yAxis": {
            "type": "category",
            "data": categories,
            "axisTick": {"show": False},
            "axisLine": {"show": False},
            "axisLabel": {
                "fontSize": 12,
                "lineHeight": 16,
            },
        },
        "series": [
            {
                "type": "bar",
                "data": [
                    {"value": v, "itemStyle": {"color": c}}
                    for v, c in zip(values, colors)
                ],
                "barWidth": 18,
                "showBackground": True,
                "backgroundStyle": {
                    "color": "rgba(180, 180, 180, 0.12)"
                },
                "label": {
                    "show": True,
                    "position": "right",
                    "formatter": "{c}",
                    "fontSize": 12,
                },
                "itemStyle": {
                    "borderRadius": [0, 6, 6, 0],
                },
            }
        ],
        "tooltip": {
            "trigger": "axis",
            "axisPointer": {"type": "shadow"},
        },
    }


def _render_relative_band_volume_bars(st, rel_bp: dict, abs_bp: dict, dominant_band: str):
    """
    Renderiza barras live de potencia relativa.
    Usa ECharts si está disponible; si no, cae al fallback nativo.
    """
    st.markdown("**Potencia relativa por banda · live**")

    if not ECHARTS_AVAILABLE:
        st.caption("streamlit-echarts no está instalado; usando render nativo.")
        _render_relative_band_volume_bars_fallback(st, rel_bp, abs_bp, dominant_band)
        return

    options = _build_echarts_volume_options(rel_bp, abs_bp, dominant_band)

    st_echarts(
        options=options,
        height="330px",
        width="100%",
        theme="streamlit",
        renderer="canvas",
        key="rel_band_live_echart",
    )


def _render_quick_reading_box(st, last_good: dict):
    """Renderiza un resumen rápido de la lectura espectral actual."""
    dom_band, dom_value = _dominant_band(last_good)
    peak_global = last_good.get("peak_freq")
    peak_alpha = last_good.get("peak_alpha")
    rms = last_good.get("rms")

    st.markdown("**Lectura rápida**")
    st.info(
        "\n".join(
            [
                f"Banda dominante actual: {str(dom_band).capitalize()}"
                + (f" (peso relativo {_fmt(dom_value, nd=3)})" if dom_value is not None else ""),
                f"Frecuencia pico global: {_fmt_hz(peak_global)}",
                f"Pico alfa: {_fmt_hz(peak_alpha)}",
                f"RMS: {_fmt(rms, nd=6)}",
            ]
        )
    )


def _render_system_status_panel(st, snapshot: dict):
    """Renderiza el panel lateral de estado del sistema."""
    status = snapshot.get("status", {}) or {}
    runtime = snapshot.get("runtime", {}) or {}
    rx = snapshot.get("rx", {}) or {}
    feat_perf = snapshot.get("feature_perf", {}) or {}
    buffer = snapshot.get("buffer", {}) or {}

    s1, s2 = st.columns(2)
    s1.metric("Estado", status.get("state_text", "n/a"))
    s2.metric("Ready", int(bool(status.get("window_ready", False))))

    # -------------------------------------------------------------------------
    # Snapshot / frescura trasladado al panel de sistema.
    # -------------------------------------------------------------------------
    snapshot_publish_age = _published_snapshot_age_s(snapshot)
    data_age = _estimated_event_age_s(snapshot, runtime.get("last_ingest_update_monotonic"))
    good_feature_age = _estimated_event_age_s(snapshot, status.get("last_good_feature_update_monotonic"))

    st.markdown("**Snapshot / frescura**")
    f1, f2 = st.columns(2)
    f1.metric("Edad publicación", f"{snapshot_publish_age:.2f}s" if snapshot_publish_age is not None else "n/a")
    f2.metric("Edad datos", f"{data_age:.2f}s" if data_age is not None else "n/a")

    f3, f4 = st.columns(2)
    f3.metric("Edad feature bueno", f"{good_feature_age:.2f}s" if good_feature_age is not None else "n/a")
    f4.metric(
        "Ventana buffer",
        f"{_fmt(buffer.get('min_seconds'), nd=2)} / {_fmt(buffer.get('needed_seconds'), nd=2)} s",
    )

    st.markdown("**Adquisición / cola**")
    a1, a2 = st.columns(2)
    a1.metric("Frame rate", _fmt_hz(rx.get("rx_frame_rate_hz")))
    a2.metric("Block rate", _fmt_hz(rx.get("rx_block_rate_hz")))

    a3, a4 = st.columns(2)
    a3.metric("Queue blocks", rx.get("queue_blocks_current", 0))
    a4.metric("Queue frames", rx.get("queue_frames_current", 0))

    a5, a6 = st.columns(2)
    a5.metric("RX frames total", rx.get("rx_frames_total", 0))
    a6.metric("Buffer ingested", buffer.get("total_samples_ingested", 0))

    st.markdown("**DSP / ventana**")
    d1, d2 = st.columns(2)
    d1.metric("Feature calls", feat_perf.get("feature_calls_window", 0))
    d2.metric("Pend samples", runtime.get("samples_since_feature", 0))

    d3, d4 = st.columns(2)
    d3.metric("Último intento", _fmt_us(status.get("last_feature_dt_us")))
    d4.metric("Estado intento", status.get("last_feature_status", "n/a"))

    d5, d6 = st.columns(2)
    d5.metric("Seq intento", status.get("feature_attempt_seq", 0))
    d6.metric("Seq último good", status.get("last_good_feature_seq", 0))

    if status.get("last_feature_error"):
        st.error(status["last_feature_error"])


