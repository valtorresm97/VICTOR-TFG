# -----------------------------------------------------------------------------
# Función principal de render del dashboard.
# -----------------------------------------------------------------------------
def render_dashboard(st):
    """Punto de entrada principal del dashboard."""
    st.set_page_config(page_title="EEG Spectral Dashboard", layout="wide")
    _init_ui_state(st)

    st.title("EEG Spectral Dashboard")
    st.caption("Visualización local de métricas espectrales EEG en Arduino UNO Q")

    # -------------------------------------------------------------------------
    # Cabecera con acciones de control del backend.
    # -------------------------------------------------------------------------
    top_left, top_right = st.columns([3.4, 1.3])

    with top_left:
        st.subheader("Panel principal · Features live")

    with top_right:
        c1, c2 = st.columns(2)

        with c1:
            if st.button("Start backend", width="stretch"):
                ok, msg = _start_backend_if_needed()
                (st.success if ok else st.error)(msg)

        with c2:
            if st.button("Stop backend", width="stretch"):
                ok, msg = _stop_backend()
                _clear_ui_snapshot_cache(st)
                (st.success if ok else st.error)(msg)

    # -------------------------------------------------------------------------
    # Fragmento 1: banner superior.
    # -------------------------------------------------------------------------
    @st.fragment(run_every=STATUS_PERIOD_SEC)
    def startup_status_fragment():
        backend_alive, snapshot, _ = _load_snapshot_for_render(st)
        _render_startup_status(st, snapshot if snapshot else None, backend_alive)

    startup_status_fragment()

    # -------------------------------------------------------------------------
    # Layout principal.
    # -------------------------------------------------------------------------
    left, right = st.columns([3.4, 1.3])

    with left:
        st.markdown("### Features live")

        # ---------------------------------------------------------------------
        # Fragmento 2: panel principal solo para streaming de features.
        # ---------------------------------------------------------------------
        @st.fragment(run_every=FAST_FEATURES_PERIOD_SEC)
        def live_features_panel():
            backend_alive, snapshot, snapshot_source = _load_snapshot_for_render(st)

            if not snapshot:
                if backend_alive:
                    st.info("Esperando datos EEG...")
                else:
                    st.info("Pulsa Start backend para iniciar adquisición y procesamiento EEG.")
                return

            status = snapshot.get("status", {}) or {}
            last_good = ((snapshot.get("features", {}) or {}).get("last_good", {}) or {})
            rel_bp = _band_rel_dict(last_good)
            abs_bp = _band_abs_dict(last_good)
            dom_band, dom_value = _dominant_band(last_good)

            m1, m2, m3, m4 = st.columns(4)
            m1.metric("Frecuencia pico global", _fmt_hz(last_good.get("peak_freq")))
            m2.metric("Pico alfa", _fmt_hz(last_good.get("peak_alpha")))
            m3.metric("Pico beta", _fmt_hz(last_good.get("peak_beta")))
            m4.metric("RMS", _fmt(last_good.get("rms"), nd=6))

            m5, m6, m7, m8 = st.columns(4)
            m5.metric("Banda dominante", str(dom_band).capitalize())
            m6.metric("Peso relativo dominante", _fmt(dom_value, nd=3))
            m7.metric("Último intento", _fmt_us(status.get("last_feature_dt_us")))
            m8.metric("Estado intento", status.get("last_feature_status", "n/a"))

            if snapshot_source == "cached":
                st.warning("Mostrando último snapshot válido en caché visual.")
            elif snapshot_source == "live":
                st.caption("Mostrando snapshot live actual.")

            _render_quick_reading_box(st, last_good)
            st.divider()
            _render_relative_band_volume_bars(st, rel_bp, abs_bp, dom_band)

        live_features_panel()

    with right:
        st.markdown("### Estado del sistema")

        # ---------------------------------------------------------------------
        # Selector de vista en fragmento propio.
        # Así evitamos full-rerun al cambiar Estado / Config / Diag.
        # ---------------------------------------------------------------------
        @st.fragment
        def system_view_selector():
            st.radio(
                "Vista sistema",
                ["Estado", "Config", "Diag"],
                horizontal=True,
                key="system_view",
                label_visibility="collapsed",
            )

        system_view_selector()

        # ---------------------------------------------------------------------
        # Fragmento 3: panel derecho del sistema.
        # ---------------------------------------------------------------------
        @st.fragment(run_every=SLOW_SYSTEM_PERIOD_SEC)
        def system_status_panel():
            backend_alive, snapshot, _ = _load_snapshot_for_render(st)

            if not snapshot:
                if backend_alive:
                    st.info("Panel de sistema pendiente de datos.")
                else:
                    st.info("Backend no activo.")
                return

            system_view = st.session_state.system_view

            if system_view == "Estado":
                _render_system_status_panel(st, snapshot)
            elif system_view == "Config":
                _render_config_panel(st, snapshot)
            else:
                _render_diagnostics_panel(st, snapshot)

        system_status_panel()